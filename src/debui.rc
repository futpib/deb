<?xml version="1.0"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="deb" version="1" translationDomain="deb">
    <MenuBar>
        <Menu name="file"><text>&amp;File</text>
            <Action name="new-tab"/>
            <Action name="new-chromium-tab"/>
            <Action name="new-firefox-tab"/>
            <Action name="new-window"/>
            <Separator/>
            <Action name="close-tab"/>
            <Action name="file_quit"/>
        </Menu>
        <Menu name="view"><text>&amp;View</text>
            <Action name="reload"/>
            <Action name="focus-location"/>
            <Separator/>
            <Action name="view-full-screen"/>
        </Menu>
        <Menu name="settings"><text>&amp;Settings</text>
            <Action name="configure-shortcuts"/>
            <Action name="configure-toolbars"/>
        </Menu>
        <Menu name="help"><text>&amp;Help</text>
        </Menu>
    </MenuBar>
    <ToolBar name="mainToolBar">
        <text>Main Toolbar</text>
        <Action name="new-tab"/>
        <Action name="reload"/>
        <Action name="engine"/>
        <Action name="location"/>
        <Action name="new-window"/>
    </ToolBar>
</gui>
