+bool IsMatchingAlloyTab(content::WebContents* contents,
+                        Profile* profile,
+                        bool include_incognito) {
+  auto* process_profile =
+      Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (process_profile != profile &&
+      !(include_incognito && profile->IsSameOrParent(process_profile))) {
+    return false;
+  }
+
+  auto browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  return browser && browser->IsAlloyStyle() &&
+         browser->GetWebContents() == contents;
+}
