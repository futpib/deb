+std::vector<content::WebContents*> GetAlloyTabs(Profile* profile,
+                                                bool include_incognito) {
+  std::vector<content::WebContents*> result;
+  for (auto rph_iterator = content::RenderProcessHost::AllHostsIterator();
+       !rph_iterator.IsAtEnd(); rph_iterator.Advance()) {
+    auto* rph = rph_iterator.GetCurrentValue();
+    if (!rph->IsInitializedAndNotDead()) {
+      continue;
+    }
+    rph->ForEachRenderFrameHost([&](content::RenderFrameHost* rfh) {
+      auto* contents = content::WebContents::FromRenderFrameHost(rfh);
+      if (!contents ||
+          std::ranges::find(result, contents) != result.end() ||
+          !IsMatchingAlloyTab(contents, profile, include_incognito)) {
+        return;
+      }
+      result.push_back(contents);
+    });
+  }
+  return result;
+}
