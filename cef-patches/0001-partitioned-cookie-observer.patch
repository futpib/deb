+    case net::CookieChangeCause::EXPIRED_OVERWRITE:
+      return CEF_COOKIE_CHANGE_CAUSE_EXPIRED_OVERWRITE;
+    case net::CookieChangeCause::INSERTED_NO_CHANGE_OVERWRITE:
+      return CEF_COOKIE_CHANGE_CAUSE_INSERTED_NO_CHANGE_OVERWRITE;
+    case net::CookieChangeCause::INSERTED_NO_VALUE_CHANGE_OVERWRITE:
+      return CEF_COOKIE_CHANGE_CAUSE_INSERTED_NO_VALUE_CHANGE_OVERWRITE;
