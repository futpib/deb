FINAL_LIBRARY = "xul"

EXTRA_JS_MODULES += [
    "DebProtocolHandler.sys.mjs",
    "FirefoxCefCommandLine.sys.mjs",
]

JAR_MANIFESTS += ["jar.mn"]
XPCOM_MANIFESTS += ["components.conf"]

XPIDL_MODULE = "FirefoxCef"
XPIDL_SOURCES += ["nsIFirefoxCefBridge.idl"]

EXPORTS.mozilla += ["FirefoxCefBridge.h"]

SOURCES += [
    "FirefoxCefBridge.cpp",
    "FirefoxCefRenderCompositor.cpp",
]

LOCAL_INCLUDES += [
    "!/ipc/ipdl/_ipdlheaders",
    "/gfx/gl",
    "/gfx/webrender_bindings",
    "/ipc/chromium/src",
    "/widget/gtk",
]

CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
