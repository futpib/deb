#include "nsISupports.idl"
#include "nsIBaseWindow.idl"

[scriptable, uuid(335ff545-2339-4216-a59e-e1cc1ef9f091)]
interface nsIFirefoxCefBridge : nsISupports
{
  readonly attribute unsigned long browserId;
  readonly attribute AUTF8String initialUrl;
  readonly attribute unsigned long initialWidth;
  readonly attribute unsigned long initialHeight;

  void runtimeReady();
  void attachWindow(in unsigned long browserId, in nsIBaseWindow baseWindow);
  void browserReady(in unsigned long browserId);
  void addressChanged(in unsigned long browserId, in AUTF8String url);
  void titleChanged(in unsigned long browserId, in AUTF8String title);
  void loadingStateChanged(in unsigned long browserId, in boolean loading);
  void fullscreenChanged(in unsigned long browserId, in boolean fullscreen);
  void loadError(in unsigned long browserId,
                 in long errorCode,
                 in AUTF8String errorText,
                 in AUTF8String failedUrl);
  void browserCrashed(in unsigned long browserId, in AUTF8String reason);
  void beforeClose(in unsigned long browserId);
};
